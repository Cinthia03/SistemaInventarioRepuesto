@@ -0,0 +1,463 @@
+:host {
+  --color-primario: #133b4b;
+  --color-primario-suave: #1c5268;
+  --color-acento: #16a34a;
+  --color-borde: #e2e8f0;
+  --color-texto: #0f172a;
+  --color-suave: #64748b;
+  --color-bg: #f8fafc;
+  --sombra: 0 12px 32px rgba(0, 0, 0, 0.18);
+  --radio: 16px;
+  --font-cuerpo: 'Segoe UI', system-ui, sans-serif;
+
+  position: fixed;
+  right: 28px;
+  bottom: 28px;
+  z-index: 1000;
+  font-family: var(--font-cuerpo);
+}
+
+/* ============== BOTÓN FLOTANTE ============== */
+.lanzador {
+  position: relative;
+  width: 62px;
+  height: 62px;
+  border-radius: 50%;
+  border: none;
+  cursor: pointer;
+  background: var(--color-primario);
+  box-shadow: var(--sombra);
+  display: flex;
+  align-items: center;
+  justify-content: center;
+  transition: transform 0.2s ease;
+}
+
+.lanzador:hover {
+  transform: translateY(-3px) scale(1.03);
+}
+
+.lanzador-avatar {
+  width: 46px;
+  height: 46px;
+  display: block;
+}
+
+.avatar-svg {
+  width: 100%;
+  height: 100%;
+  display: block;
+}
+
+.lanzador-punto {
+  position: absolute;
+  top: 2px;
+  right: 4px;
+  width: 12px;
+  height: 12px;
+  border-radius: 50%;
+  background: #22c55e;
+  border: 2px solid #fff;
+}
+
+/* ============== PANEL ============== */
+.panel {
+  width: 360px;
+  max-height: min(560px, 80vh);
+  background: #fff;
+  border-radius: var(--radio);
+  box-shadow: var(--sombra);
+  display: flex;
+  flex-direction: column;
+  overflow: hidden;
+  border: 1px solid var(--color-borde);
+}
+
+.panel-header {
+  background: var(--color-primario);
+  color: #fff;
+  padding: 14px 16px;
+  display: flex;
+  align-items: center;
+  justify-content: space-between;
+  flex-shrink: 0;
+}
+
+.panel-header__izq {
+  display: flex;
+  align-items: center;
+  gap: 10px;
+  min-width: 0;
+}
+
+.panel-avatar {
+  width: 36px;
+  height: 36px;
+  flex-shrink: 0;
+  border-radius: 50%;
+  overflow: hidden;
+  background: rgba(255, 255, 255, 0.15);
+}
+
+.panel-titulos {
+  display: flex;
+  flex-direction: column;
+  line-height: 1.25;
+  min-width: 0;
+}
+
+.panel-titulos strong {
+  font-size: 14px;
+}
+
+.panel-titulos span {
+  font-size: 11px;
+  opacity: 0.85;
+}
+
+.btn-volver,
+.btn-cerrar,
+.btn-icono-mini {
+  background: transparent;
+  border: none;
+  color: #fff;
+  cursor: pointer;
+  display: flex;
+  align-items: center;
+  justify-content: center;
+  padding: 4px;
+  border-radius: 8px;
+  flex-shrink: 0;
+}
+
+.btn-volver:hover,
+.btn-cerrar:hover {
+  background: rgba(255, 255, 255, 0.15);
+}
+
+.btn-icono-mini {
+  color: var(--color-suave);
+}
+
+.btn-icono-mini:hover {
+  background: var(--color-bg);
+}
+
+/* ============== CUERPO ============== */
+.panel-body {
+  padding: 16px;
+  overflow-y: auto;
+  flex: 1;
+  background: var(--color-bg);
+  display: flex;
+  flex-direction: column;
+  gap: 14px;
+}
+
+.burbuja {
+  background: #fff;
+  border: 1px solid var(--color-borde);
+  border-radius: 14px;
+  border-top-left-radius: 4px;
+  padding: 12px 14px;
+  font-size: 13px;
+  line-height: 1.5;
+  color: var(--color-texto);
+}
+
+.burbuja--suave {
+  background: #f1f5f9;
+  color: var(--color-suave);
+  font-style: italic;
+}
+
+.burbuja--exito {
+  background: #f0fdf4;
+  border-color: #bbf7d0;
+  color: #14532d;
+}
+
+/* ============== OPCIONES DE MENÚ ============== */
+.opciones {
+  display: flex;
+  flex-direction: column;
+  gap: 8px;
+}
+
+.opcion {
+  display: flex;
+  align-items: center;
+  gap: 12px;
+  background: #fff;
+  border: 1px solid var(--color-borde);
+  border-radius: 12px;
+  padding: 10px 12px;
+  cursor: pointer;
+  text-align: left;
+  transition: box-shadow 0.2s ease, transform 0.2s ease;
+}
+
+.opcion:hover {
+  box-shadow: 0 6px 16px rgba(0, 0, 0, 0.08);
+  transform: translateY(-1px);
+}
+
+.opcion mat-icon {
+  color: var(--color-primario);
+  flex-shrink: 0;
+}
+
+.opcion span {
+  display: flex;
+  flex-direction: column;
+  gap: 1px;
+}
+
+.opcion strong {
+  font-size: 13px;
+  color: var(--color-texto);
+}
+
+.opcion small {
+  font-size: 11px;
+  color: var(--color-suave);
+}
+
+.opcion--destacada {
+  border-color: var(--color-primario);
+  background: #eef5f8;
+}
+
+/* ============== LISTAS SIMPLES (stock / actividad / resultado) ============== */
+.lista-simple {
+  display: flex;
+  flex-direction: column;
+  gap: 8px;
+  max-height: 260px;
+  overflow-y: auto;
+}
+
+.fila-simple {
+  display: flex;
+  align-items: flex-start;
+  gap: 10px;
+  background: #fff;
+  border: 1px solid var(--color-borde);
+  border-radius: 10px;
+  padding: 8px 10px;
+}
+
+.fila-simple__texto {
+  display: flex;
+  flex-direction: column;
+  gap: 1px;
+}
+
+.fila-simple__texto strong {
+  font-size: 12.5px;
+  color: var(--color-texto);
+}
+
+.fila-simple__texto small {
+  font-size: 11px;
+  color: var(--color-suave);
+}
+
+.icono-alerta { color: #c2410c; }
+.icono-actividad { color: var(--color-primario); }
+.icono-exito { color: var(--color-acento); }
+
+/* ============== AYUDA ============== */
+.lista-ayuda {
+  margin: 0;
+  padding-left: 18px;
+  display: flex;
+  flex-direction: column;
+  gap: 8px;
+  font-size: 12.5px;
+  color: var(--color-texto);
+}
+
+/* ============== SUBIDA DE XML ============== */
+.zona-subida {
+  display: flex;
+  align-items: center;
+  justify-content: center;
+  gap: 8px;
+  border: 2px dashed var(--color-primario);
+  border-radius: 12px;
+  padding: 20px 12px;
+  cursor: pointer;
+  color: var(--color-primario);
+  font-size: 13px;
+  font-weight: 600;
+  background: #fff;
+  transition: background 0.2s ease;
+}
+
+.zona-subida:hover {
+  background: #eef5f8;
+}
+
+.lista-archivos {
+  display: flex;
+  flex-direction: column;
+  gap: 6px;
+}
+
+.archivo-item {
+  display: flex;
+  align-items: center;
+  gap: 8px;
+  background: #fff;
+  border: 1px solid var(--color-borde);
+  border-radius: 8px;
+  padding: 6px 10px;
+  font-size: 12px;
+}
+
+.archivo-item mat-icon {
+  color: var(--color-suave);
+  font-size: 18px;
+  width: 18px;
+  height: 18px;
+}
+
+.archivo-nombre {
+  flex: 1;
+  overflow: hidden;
+  text-overflow: ellipsis;
+  white-space: nowrap;
+}
+
+.errores {
+  display: flex;
+  flex-direction: column;
+  gap: 4px;
+}
+
+.error-item {
+  font-size: 11.5px;
+  color: #b91c1c;
+  background: #fef2f2;
+  border: 1px solid #fecaca;
+  border-radius: 8px;
+  padding: 6px 10px;
+}
+
+/* ============== REVISIÓN DE PROPUESTAS ============== */
+.acciones-masivas {
+  display: flex;
+  gap: 12px;
+}
+
+.btn-texto {
+  background: none;
+  border: none;
+  color: var(--color-primario);
+  font-size: 12px;
+  font-weight: 600;
+  cursor: pointer;
+  padding: 0;
+}
+
+.lista-propuestas {
+  display: flex;
+  flex-direction: column;
+  gap: 8px;
+  max-height: 280px;
+  overflow-y: auto;
+}
+
+.propuesta {
+  display: flex;
+  align-items: flex-start;
+  gap: 10px;
+  background: #fff;
+  border: 1px solid var(--color-borde);
+  border-radius: 10px;
+  padding: 10px;
+}
+
+.propuesta--sin-match {
+  opacity: 0.6;
+}
+
+.propuesta__info {
+  display: flex;
+  flex-direction: column;
+  gap: 3px;
+  min-width: 0;
+}
+
+.propuesta__info strong {
+  font-size: 12.5px;
+  color: var(--color-texto);
+}
+
+.propuesta__info small {
+  font-size: 11px;
+  color: var(--color-suave);
+}
+
+.propuesta__precios {
+  display: flex;
+  align-items: center;
+  gap: 6px;
+  font-size: 12.5px;
+  font-weight: 700;
+  margin-top: 2px;
+}
+
+.propuesta__precios mat-icon {
+  font-size: 14px;
+  width: 14px;
+  height: 14px;
+  color: var(--color-suave);
+}
+
+.precio-anterior {
+  color: var(--color-suave);
+  text-decoration: line-through;
+}
+
+.precio-nuevo {
+  color: var(--color-acento);
+}
+
+/* ============== BOTÓN PRIMARIO ============== */
+.btn-primario {
+  display: flex;
+  align-items: center;
+  justify-content: center;
+  gap: 8px;
+  background: var(--color-primario);
+  color: #fff;
+  border: none;
+  border-radius: 10px;
+  padding: 11px;
+  font-size: 13px;
+  font-weight: 600;
+  cursor: pointer;
+  transition: background 0.2s ease;
+}
+
+.btn-primario:hover:not(:disabled) {
+  background: var(--color-primario-suave);
+}
+
+.btn-primario:disabled {
+  opacity: 0.5;
+  cursor: not-allowed;
+}
+
+/* ============== RESPONSIVE ============== */
+@media (max-width: 480px) {
+  :host {
+    right: 12px;
+    bottom: 12px;
+  }
+  .panel {
+    width: calc(100vw - 24px);
+  }
+}
diff --git a/src/app/shared/components/asistente-inventario/asistente-inventario.html b/src/app/shared/components/asistente-inventario/asistente-inventario.html
